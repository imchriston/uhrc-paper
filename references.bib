@misc{yu_survey_2023,
	title = {A {Survey} on {Neural}-symbolic {Learning} {Systems}},
	url = {http://arxiv.org/abs/2111.08164},
	doi = {10.48550/arXiv.2111.08164},
	abstract = {In recent years, neural systems have demonstrated highly effective learning ability and superior perception intelligence. However, they have been found to lack effective reasoning and cognitive ability. On the other hand, symbolic systems exhibit exceptional cognitive intelligence but suffer from poor learning capabilities when compared to neural systems. Recognizing the advantages and disadvantages of both methodologies, an ideal solution emerges: combining neural systems and symbolic systems to create neural-symbolic learning systems that possess powerful perception and cognition. The purpose of this paper is to survey the advancements in neural-symbolic learning systems from four distinct perspectives: challenges, methods, applications, and future directions. By doing so, this research aims to propel this emerging field forward, offering researchers a comprehensive and holistic overview. This overview will not only highlight the current state-of-the-art but also identify promising avenues for future research.},
	urldate = {2025-09-12},
	publisher = {arXiv},
	author = {Yu, Dongran and Yang, Bo and Liu, Dayou and Wang, Hui and Pan, Shirui},
	month = jun,
	year = {2023},
	note = {arXiv:2111.08164 [cs]},
	keywords = {notion, symbolic models, neural learning, symbolic framework},
	annote = {• Neural-symbolic learning systems combine the neural systems and the symbolic systems into a unified framework.
Highlights


Mentions the combination of neural and symbolic systems into a unified framework for neural-symbolic learning systems.


Notes the capability of neural-symbolic learning systems to equip AI with perception and cognition abilities.


Highlights the importance of a well-balanced combination of neural and symbolic systems for optimal performance.


Abstract


Presents the motivation for neural-symbolic learning systems, highlighting the strengths and weaknesses of neural and symbolic systems.


Describes the purpose of the paper, which is to survey advancements in neural-symbolic learning systems from four perspectives: challenges, methods, applications, and future directions.


Notes the paper's aim to provide a comprehensive overview of the field, highlight state-of-the-art advancements, and identify promising future research avenues.


Introduction


Discusses the historical context of AI, highlighting the shift from reasoning and knowledge-based systems to machine learning and the emergence of neural networks.


Presents the limitations of neural networks in reasoning and explainability, while acknowledging their success in perception tasks.


Describes the benefits of symbolic systems in reasoning and interpretability.


Highlights the advantages of neural-symbolic learning systems in terms of efficiency, generalization, and interpretability.


Categorization and Frameworks


Presents a formal definition of neural-symbolic learning systems.


Proposes a novel taxonomy of neural-symbolic learning systems, classifying them into three categories: learning for reasoning, reasoning for learning, and learning-reasoning.


Describes the frameworks for each category, including their key characteristics and integration modes.


Methods of neural-symbolic learning systems


Presents a detailed overview of various methods employed in neural-symbolic learning systems.


Discusses learning for reasoning methods, focusing on how neural networks accelerate symbolic reasoning and abstract unstructured data for symbolic reasoning.


Discusses reasoning for learning methods, including regularization models and knowledge transfer models.


Discusses learning-reasoning methods, emphasizing the bidirectional interaction between neural and symbolic systems.


Applications


Discusses several applications of neural-symbolic learning systems.


Mentions the use in object/visual-relationship detection, highlighting the integration of external knowledge to enhance model performance.


Mentions the use in knowledge graph reasoning, emphasizing the role of link prediction and knowledge completion.


Mentions the use in classification/few-shot classification, focusing on leveraging logical knowledge and common sense knowledge.


Mentions the use in intelligent question answering, highlighting the importance of contextual information from text and images.


Mentions the use in reinforcement learning, focusing on integrating symbolic knowledge into deep reinforcement learning and hierarchical reinforcement learning.


Future directions


Presents potential future research directions for neural-symbolic learning systems.


Mentions the need for efficient methods to address the computational challenges of symbolic reasoning.


Mentions the development of techniques for automatic construction of symbolic knowledge, particularly logic rules.


Mentions the importance of advancing symbolic representation learning, focusing on robust and efficient methods to capture semantic similarities.


Mentions the expansion of neural-symbolic learning systems into new application domains, such as COVID-19 research and advanced robotics.


Conclusion


Summarizes the key contributions of the paper, emphasizing the proposed taxonomy, structured categorization, and discussion of techniques, applications, and future directions.


Highlights the significance of neural-symbolic learning systems in both theory and application, advocating for further in-depth research and discussion in the field.


},
	file = {Full Text PDF:C\:\\Users\\nunes\\Zotero\\storage\\XASJVX55\\Yu et al. - 2023 - A Survey on Neural-symbolic Learning Systems.pdf:application/pdf;Snapshot:C\:\\Users\\nunes\\Zotero\\storage\\ZGXHKMP6\\2111.html:text/html},
