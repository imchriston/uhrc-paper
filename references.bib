	keywords = {notion, Deep reinforcement learning, Path planning, reinforcement learning},
	pages = {7654},
	file = {Full Text:C\:\\Users\\nunes\\Zotero\\storage\\8H6MVA6G\\Jaramillo-Martínez et al. - 2024 - Reinforcement-Learning-Based Path Planning A Reward Function Strategy.pdf:application/pdf},
