@inproceedings{sadati_hierarchical_2008,
	address = {Singapore},
	title = {Hierarchical optimal control of nonlinear systems; {An} application to a benchmark {CSTR} problem},
	copyright = {https://doi.org/10.15223/policy-029},
	isbn = {978-1-4244-1717-9},
	url = {https://ieeexplore.ieee.org/document/4582557/},
	doi = {10.1109/ICIEA.2008.4582557},
	urldate = {2025-09-12},
	booktitle = {2008 3rd {IEEE} {Conference} on {Industrial} {Electronics} and {Applications}},
	publisher = {IEEE},
	author = {Sadati, N. and Ramezani, M. H.},
	month = jun,
	year = {2008},
	keywords = {notion, hierarchical control, nonlinear hierarchical control, traditional hierarchical control},
	pages = {455--460},
	annote = {Hierarchical Optimal Control of Nonlinear Systems; An Application to a Benchmark CSTR Problem
Abstract


Describes a novel computational algorithm for hierarchical optimal control of nonlinear systems.


Presents a new coordination strategy based on the gradient of the coordination errors.


Demonstrates the performance and convergence rate of the proposed approach through simulations of a benchmark continuous stirred tank reactor (CSTR) problem.


Compares the proposed approach to the classical gradient-type interaction prediction approach.


Introduction


Notes the complexity and dimensionality problems of centralized optimal control in large-scale systems.


Highlights the feasibility of hierarchical structures in reducing complexity through decomposition and parallel processing.


Mentions two main hierarchical approaches for dynamic optimization problems: Goal Coordination Method and Interaction Prediction Approach.


Discusses the limitations of the Goal Coordination Method and the applicability of the Interaction Prediction Approach.


Statement of the Problem


Presents a discrete-time dynamic system with bounded control inputs.


Defines the optimal control problem as finding the control policy that minimizes a given performance index over a specified time interval.


Decomposition of the Overall Problem into Sub-Problems


Divides the system dynamics into interactive sub-systems with nonlinear state equations.


Decomposes the overall cost function into separate cost functions for each sub-system.


Defines the interaction vector for each sub-system as a function of the states and inputs of other sub-systems.


Introduces the overall Lagrangian function and the necessary conditions for optimality.


Optimization of the First Level Sub-Problems


Restates the necessary conditions for optimality for the first level sub-problems.


Outlines the steps of the gradient algorithm used to solve the sub-problems.


Explains the process of updating the control inputs using the gradient of the Lagrangian function.


Solving the Second Level Problem (Coordination)


Defines the calculated coordination vector and the predicted coordination vector.


Explains the classical gradient-type algorithm (mixed method) for modifying the coordination vector.


Introduces a new gradient-type coordination approach based on the coordination error.


Defines a new cost function based on the norm of the coordination error.


Presents the gradient and Newton algorithms for updating the coordination vector.


Derives the gradient matrix used in the Newton algorithm.


Summarizes the steps of the new interaction prediction approach based on the proposed coordination scheme.


Simulation Results


Uses a continuous stirred tank reactor (CSTR) with a nonlinear fourth-order model as a benchmark problem.


Presents the mathematical model of the reactor based on material and heat balances.


Defines the state and input vectors and discretizes the system equations.


Specifies the cost function and its parameters.


Decomposes the overall problem into two sub-problems.


Compares the convergence rate of the proposed approach to the classical mixed method.


Shows the optimal states and inputs of the CSTR obtained using the proposed approach.


Conclusion


Summarizes the proposed two-level method for optimization of large-scale nonlinear systems.


Highlights the faster convergence rate of the proposed approach compared to the classical mixed method.


Emphasizes the reduced number of information exchanges between the two levels.


},
}

@misc{zhu_hierarchical_2024,
	title = {Hierarchical {Control} for {Vehicle} {Repositioning} in {Autonomous} {Mobility} on {Demand} {Systems}},
	url = {http://arxiv.org/abs/2406.09609},
	doi = {10.48550/arXiv.2406.09609},
	abstract = {Balancing passenger demand and vehicle availability is crucial for ensuring the sustainability and effectiveness of urban transportation systems. To address this challenge, we propose a novel hierarchical strategy for the efficient distribution of empty vehicles in urban areas. The proposed approach employs a data-enabled predictive control algorithm to develop a high-level controller, which guides the inter-regional allocation of idle vehicles. This algorithm utilizes historical data on passenger demand and vehicle supply in each region to construct a non-parametric representation of the system, enabling it to determine the optimal number of vehicles to be repositioned or retained in their current regions without modeling the system. At the low level, a coverage control-based controller is designed to provide inter-regional position guidance, determining the desired road intersection each vehicle should target. With the objective of optimizing area coverage, it aligns the vehicle distribution with the demand across different districts within a single region. The effectiveness of the proposed method is validated through simulation experiments on the real road network of Shenzhen, China. The integration of the two layers provides better performance compared to applying either layer in isolation, demonstrating its potential to reduce passenger waiting time and answer more requests, thus promoting the development of more efficient and sustainable transportation systems.},
	urldate = {2025-09-12},
	publisher = {arXiv},
	author = {Zhu, Pengbo and Ferrari-Trecate, Giancarlo and Geroliminis, Nikolas},
	month = jun,
	year = {2024},
	note = {arXiv:2406.09609 [eess]
version: 1},
	keywords = {notion, hierarchical control, traditional hierarchical control},
	file = {Zhu et al. - 2024 - Hierarchical Control for Vehicle Repositioning in Autonomous Mobility on Demand Systems.pdf:application/pdf;Snapshot:C\:\\Users\\nunes\\Zotero\\storage\\ZXCXJJX4\\2406.html:text/html},
}

@misc{li_seek_2025,
	title = {Seek in the {Dark}: {Reasoning} via {Test}-{Time} {Instance}-{Level} {Policy} {Gradient} in {Latent} {Space}},
	shorttitle = {Seek in the {Dark}},
	url = {http://arxiv.org/abs/2505.13308},
	doi = {10.48550/arXiv.2505.13308},
	abstract = {Reasoning ability, a core component of human intelligence, continues to pose a significant challenge for Large Language Models (LLMs) in the pursuit of AGI. Although model performance has improved under the training scaling law, significant challenges remain, particularly with respect to training algorithms, such as catastrophic forgetting, and the limited availability of novel training data. As an alternative, test-time scaling enhances reasoning performance by increasing test-time computation without parameter updating. Unlike prior methods in this paradigm focused on token space, we propose leveraging latent space for more effective reasoning and better adherence to the test-time scaling law. We introduce LatentSeek, a novel framework that enhances LLM reasoning through Test-Time Instance-level Adaptation (TTIA) within the model's latent space. Specifically, LatentSeek leverages policy gradient to iteratively update latent representations, guided by self-generated reward signals. LatentSeek is evaluated on a range of reasoning benchmarks, including GSM8K, MATH-500, and AIME2024, across multiple LLM architectures. Results show that LatentSeek consistently outperforms strong baselines, such as Chain-of-Thought prompting and fine-tuning-based methods. Furthermore, our analysis demonstrates that LatentSeek is highly efficient, typically converging within a few iterations for problems of average complexity, while also benefiting from additional iterations, thereby highlighting the potential of test-time scaling in the latent space. These findings position LatentSeek as a lightweight, scalable, and effective solution for enhancing the reasoning capabilities of LLMs.},
	urldate = {2025-09-12},
	publisher = {arXiv},
	author = {Li, Hengli and Li, Chenxi and Wu, Tong and Zhu, Xuekai and Wang, Yuxuan and Yu, Zhaoxin and Jiang, Eric Hanchen and Zhu, Song-Chun and Jia, Zixia and Wu, Ying Nian and Zheng, Zilong},
	month = may,
	year = {2025},
	note = {arXiv:2505.13308 [cs]},
	keywords = {notion, latent seek, resoning in latent space},
	annote = {Seek in the Dark: Reasoning via Test-Time Instance-Level Policy Gradient in Latent Space
Introduction


Describes LATENTSEEK, a framework that iteratively updates latent representations of Large Language Models (LLMs) at test time to enhance reasoning capabilities.


Explains Test-Time Instance-level Adaptation (TTIA), the framework within which LATENTSEEK operates.


Mentions the advantages of TTIA and describes how LATENTSEEK leverages policy gradients to update latent representations guided by self-generated rewards.


Test-Time Instance-Level Adaptation (TTIA) in Latent Space


Presents the problem formulation for TTIA in reasoning tasks.


Discusses the optimization of latent representations using policy gradients, and justifies the independence of latent representations with theoretical analysis.


Describes the LATENTSEEK algorithm, including its decoding strategy, reward function, and techniques for stable and efficient optimization, such as CoT initialization and fractional sequence optimization.


Empirical Results


Presents the experimental setup, including the reward mechanism, prompt designation, backbone LLMs, benchmarks, and baselines used for evaluation.


Presents the results on GSM8K, MATH-500, and AIME2024, highlighting the strong performance of LATENTSEEK compared to various baselines, including CoT prompting, Best-of-N, reinforcement learning methods, and supervised fine-tuning.


Discusses the generalizability of LATENTSEEK across different LLM families and model sizes.


Ideal Experiment: Perfect Sparse Reward Model


Discusses experiments conducted using a Perfect Sparse Reward Model (PSRM) to evaluate the effectiveness of exploration within the latent space.


Notes that the PSRM model leads to significant performance gains despite limited feedback, demonstrating the potential of LATENTSEEK even with sparse rewards.


Mentions observations that suggest smaller models may lack effective knowledge elicitation mechanisms, and that LATENTSEEK can help activate implicit knowledge.


Test-Time Scaling: scaling up the iteration of LATENTSEEK


Proposes a novel test-time scaling approach by increasing the number of LATENTSEEK iterations rather than the number of generated tokens.


Presents the relationship between model performance on GSM8K and the number of iterations, showing that performance improves with additional iterations.


Discusses extreme scaling experiments using Qwen2. 5-1.5 B-Instruct, highlighting the potential of latent space for efficient test-time scaling.


Algorithmic Statistics


Presents statistics on the ratio of final answer tokens to CoT tokens and average number of update iterations.


Highlights the efficiency of LATENTSEEK, showing that it typically converges within a few iterations for problems of average complexity.


Qualitative Analysis


Presents an analysis of the first three generated tokens in GSM8K, highlighting the divergence of LLM reasoning from human cognitive strategies.


Provides case studies illustrating how LATENTSEEK produces correct answers despite generating seemingly incoherent reasoning steps.


Related Work


Briefly discusses related work on reasoning in language models, reinforcement learning for language models, controllable generation, test-time optimization, prompt tuning, and soft prompt.


Conclusion


Summarizes the contributions of LATENTSEEK as a novel, efficient, and scalable approach for enhancing reasoning in LLMs.


Highlights the potential of TTIA in the latent space for improving LLM capabilities, and mentions future directions for research.


},
	file = {Li et al. - 2025 - Seek in the Dark Reasoning via Test-Time Instance-Level Policy Gradient in Latent Space.pdf:application/pdf;Snapshot:C\:\\Users\\nunes\\Zotero\\storage\\FQIQDH95\\2505.html:text/html},
}

@misc{geiping_scaling_2025,
	title = {Scaling up {Test}-{Time} {Compute} with {Latent} {Reasoning}: {A} {Recurrent} {Depth} {Approach}},
	shorttitle = {Scaling up {Test}-{Time} {Compute} with {Latent} {Reasoning}},
	url = {http://arxiv.org/abs/2502.05171},
	doi = {10.48550/arXiv.2502.05171},
	abstract = {We study a novel language model architecture that is capable of scaling test-time computation by implicitly reasoning in latent space. Our model works by iterating a recurrent block, thereby unrolling to arbitrary depth at test-time. This stands in contrast to mainstream reasoning models that scale up compute by producing more tokens. Unlike approaches based on chain-of-thought, our approach does not require any specialized training data, can work with small context windows, and can capture types of reasoning that are not easily represented in words. We scale a proof-of-concept model to 3.5 billion parameters and 800 billion tokens. We show that the resulting model can improve its performance on reasoning benchmarks, sometimes dramatically, up to a computation load equivalent to 50 billion parameters.},
	urldate = {2025-09-12},
	publisher = {arXiv},
	author = {Geiping, Jonas and McLeish, Sean and Jain, Neel and Kirchenbauer, John and Singh, Siddharth and Bartoldson, Brian R. and Kailkhura, Bhavya and Bhatele, Abhinav and Goldstein, Tom},
