	note = {arXiv:2502.05171 [cs]},
	keywords = {notion, Computer Science - Machine Learning, Computer Science - Computation and Language},
	annote = {Comment: The model is available at https://huggingface.co/tomg-group-umd/huginn-0125. Code and data recipe can be found at https://github.com/seal-rg/recurrent-pretraining},
	file = {Full Text PDF:C\:\\Users\\nunes\\Zotero\\storage\\ULHHMGFE\\Geiping et al. - 2025 - Scaling up Test-Time Compute with Latent Reasoning A Recurrent Depth Approach.pdf:application/pdf;Snapshot:C\:\\Users\\nunes\\Zotero\\storage\\3ML8NFPW\\2502.html:text/html},
}

@misc{jin_decoupled_2025,
	title = {Decoupled {Planning} and {Execution}: {A} {Hierarchical} {Reasoning} {Framework} for {Deep} {Search}},
	shorttitle = {Decoupled {Planning} and {Execution}},
	url = {http://arxiv.org/abs/2507.02652},
	doi = {10.48550/arXiv.2507.02652},
	abstract = {Complex information needs in real-world search scenarios demand deep reasoning and knowledge synthesis across diverse sources, which traditional retrieval-augmented generation (RAG) pipelines struggle to address effectively. Current reasoning-based approaches suffer from a fundamental limitation: they use a single model to handle both high-level planning and detailed execution, leading to inefficient reasoning and limited scalability. In this paper, we introduce HiRA, a hierarchical framework that separates strategic planning from specialized execution. Our approach decomposes complex search tasks into focused subtasks, assigns each subtask to domain-specific agents equipped with external tools and reasoning capabilities, and coordinates the results through a structured integration mechanism. This separation prevents execution details from disrupting high-level reasoning while enabling the system to leverage specialized expertise for different types of information processing. Experiments on four complex, cross-modal deep search benchmarks demonstrate that HiRA significantly outperforms state-of-the-art RAG and agent-based systems. Our results show improvements in both answer quality and system efficiency, highlighting the effectiveness of decoupled planning and execution for multi-step information seeking tasks. Our code is available at https://github.com/ignorejjj/HiRA.},
	urldate = {2025-09-12},
	publisher = {arXiv},
	author = {Jin, Jiajie and Li, Xiaoxi and Dong, Guanting and Zhang, Yuyao and Zhu, Yutao and Zhao, Yang and Qian, Hongjin and Dou, Zhicheng},
	month = jul,
	year = {2025},
	note = {arXiv:2507.02652 [cs]},
	keywords = {notion, decoupled planning, hierarchical reasoning model, HRM, HRM framework},
	annote = {Decoupled Planning and Execution: A Hierarchical Reasoning Framework for Deep Search
Introduction


Describes the limitations of traditional search engines and the emergence of deep search tasks.


Discusses the shortcomings of current retrieval-augmented generation (RAG) methods and large reasoning models (LRMs) for handling complex search tasks.


Introduces HiRA, a hierarchical reasoning framework that separates planning from execution to enhance deep search effectiveness.


Highlights the key contributions of HiRA, including a hierarchical reasoning architecture, enhanced capability integration, and superior empirical performance.


Related Work


Reviews the evolution of information retrieval from RAG to deep search, emphasizing the limitations of predefined workflows and single-model approaches.


Discusses existing approaches to planning-execution separation in AI agents, highlighting limitations in task decomposition and executor specialization.


Positions HiRA as a novel framework that addresses these limitations by introducing dynamic reasoning delegation and domain-specialized agents within a hierarchical structure.


Methodology


Presents the problem formulation, defining the goal of HiRA as producing a solution (answer and reasoning process) for a given query and environment.


Provides an overview of the HiRA framework, illustrating the three-tier architecture: Meta Reasoning Planner, Adaptive Reasoning Coordinator, and Domain-Specialized Executors.


Explains the hierarchical reasoning paradigm of HiRA, detailing the functions and operations of each component.


Hierarchical Reasoning Paradigm


Details the functions of the Meta Reasoning Planner, which breaks down complex tasks into subtasks and delegates them to specialized agents.


Describes how the Adaptive Reasoning Coordinator assigns subtasks to appropriate agents, transfers reasoning between agents, and manages memory.


Outlines the three capability dimensions of the Domain-Specialized Executors (Information Acquisition, Cross-Modal Understanding, and Computational Reasoning) and their implementation.


Experimental Settings


Describes the four datasets used for evaluating HiRA: GAIA, WebWalkerQA, SimpleQA, and Humanity's Last Exam.


Lists the baselines used for comparison, encompassing Direct Reasoning, Single-Capability Enhanced, and Multi-Capability Reasoning approaches.


Provides implementation details for HiRA and baselines, including model selection, tool usage, and experimental parameters.


Experimental Results


Presents the main results of HiRA's performance on the four deep search tasks, demonstrating its overall superiority compared to baselines.


Highlights the advantages of HiRA's hierarchical design over monolithic reasoning models and existing planning-based methods.


Shows HiRA's robustness across tasks of varying complexity, exhibiting significant gains on complex reasoning tasks while maintaining consistent performance on simpler tasks.


Ablation Study


Presents ablation study results, analyzing the contributions of the Coordinator Layer (Reasoning Transfer and Memory mechanisms) and Executor Layer (Search, Code, and Multimodal agents).


Demonstrates the significance of the Reasoning Transfer mechanism and the importance of individual expert agents for achieving optimal performance.


Generalization and Effectiveness of Meta Planner


Investigates the generalization and effectiveness of the Meta Planner by removing expert capability information and varying the number of subtasks.


Shows that the Meta Planner remains effective even without agent information, indicating a decoupled design and potential for scalability.


Discusses the trade-off between reasoning depth and plan efficiency when scaling the number of subtasks.


Capability Analysis


Evaluates HiRA's capabilities beyond web search using additional GAIA subsets focusing on multimodal understanding and file understanding.


Demonstrates HiRA's strong performance across all capability dimensions, surpassing baselines in handling non-textual tasks.


Efficiency Analysis


Analyzes HiRA's efficiency by comparing reasoning length and environment interaction times with baselines.


Highlights HiRA's efficiency in terms of both reasoning steps and tool calls compared to direct tool integration approaches.


Conclusion


Summarizes the key contributions and achievements of HiRA as a hierarchical reasoning framework for deep search tasks.


Emphasizes the effectiveness of decoupling planning and execution, enabling scalable and modular reasoning with domain-specialized agents.


Concludes by highlighting HiRA's superior performance and flexibility in addressing complex information retrieval challenges.


Appendix


Provides detailed information about datasets, evaluation metrics, baseline implementations, and instruction templates used in the experiments.


Offers a comprehensive description of the Domain-Specific Agents, Coordinator functions, and Memory mechanism within HiRA.


Includes a case study from the GAIA dataset, illustrating the step-by-step reasoning process of HiRA in solving a complex search task.


