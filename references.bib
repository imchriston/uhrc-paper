@misc{wang_hierarchical_2025,
	title = {Hierarchical {Reasoning} {Model}},
	url = {http://arxiv.org/abs/2506.21734},
	doi = {10.48550/arXiv.2506.21734},
	abstract = {Reasoning, the process of devising and executing complex goal-oriented action sequences, remains a critical challenge in AI. Current large language models (LLMs) primarily employ Chain-of-Thought (CoT) techniques, which suffer from brittle task decomposition, extensive data requirements, and high latency. Inspired by the hierarchical and multi-timescale processing in the human brain, we propose the Hierarchical Reasoning Model (HRM), a novel recurrent architecture that attains significant computational depth while maintaining both training stability and efficiency. HRM executes sequential reasoning tasks in a single forward pass without explicit supervision of the intermediate process, through two interdependent recurrent modules: a high-level module responsible for slow, abstract planning, and a low-level module handling rapid, detailed computations. With only 27 million parameters, HRM achieves exceptional performance on complex reasoning tasks using only 1000 training samples. The model operates without pre-training or CoT data, yet achieves nearly perfect performance on challenging tasks including complex Sudoku puzzles and optimal path finding in large mazes. Furthermore, HRM outperforms much larger models with significantly longer context windows on the Abstraction and Reasoning Corpus (ARC), a key benchmark for measuring artificial general intelligence capabilities. These results underscore HRM's potential as a transformative advancement toward universal computation and general-purpose reasoning systems.},
	urldate = {2025-09-10},
	publisher = {arXiv},
	author = {Wang, Guan and Li, Jin and Sun, Yuhao and Chen, Xing and Liu, Changling and Wu, Yue and Lu, Meng and Song, Sen and Yadkori, Yasin Abbasi},
	month = aug,
	year = {2025},
	note = {arXiv:2506.21734 [cs]},
	keywords = {notion, reasoning model, model based reasoning, hierarchical reasoning model, HRM},
	annote = {Hierarchical Reasoning Model
Abstract


Describes the Hierarchical Reasoning Model (HRM), a novel recurrent architecture for AI reasoning inspired by the hierarchical and multi-timescale processing in the human brain.


Highlights the limitations of Chain-of-Thought (CoT) techniques and the need for "latent reasoning" where computations are conducted within the model's internal hidden state space.


Presents the design and components of HRM, including its two coupled recurrent modules: a high-level module (H) for abstract, deliberate reasoning, and a low-level module (L) for fast, detailed computations.


Introduces the concept of "hierarchical convergence" in HRM, where the slow-updating H-module guides the fast-updating L-module, enabling deep, multi-stage reasoning.


Approximate Gradient


Explains the one-step gradient approximation used for training HRM, which improves efficiency and eliminates the need for Backpropagation Through Time (BPTT).


Discusses the theoretical grounding of the approximation in Deep Equilibrium Models (DEQ) and the Implicit Function Theorem (IFT).


Presents the benefits of the one-step gradient approach, including its constant memory footprint and biological plausibility.


Deep Supervision and Adaptive Computational Time


Introduces the deep supervision mechanism in HRM, which provides more frequent feedback to the H-module and serves as a regularization mechanism.


Presents the Adaptive Computational Time (ACT) mechanism in HRM, allowing it to dynamically adjust its computational effort based on task complexity, inspired by the brain's switching between "System 1" and "System 2" thinking.


Explains how ACT is implemented using Q-learning to determine the optimal number of computational segments for a given task.


Results


Describes the ARC-AGI, Sudoku-Extreme, and Maze-Hard benchmarks used to evaluate HRM.


Presents the performance of HRM on these benchmarks, demonstrating its superior accuracy and data efficiency compared to state-of-the-art CoT models.


Visualizes intermediate timesteps in HRM's reasoning process, providing insights into the underlying algorithms and strategies the model employs for different tasks.


Brain Correspondence


Highlights the neuroscientific principle that a brain region's functional repertoire is linked to the dimensionality of its neural representations, with higher-order cortical areas exhibiting higher dimensionality.


Notes that HRM reproduces this dimensionality hierarchy, with the high-level module operating in a higher-dimensional space than the low-level module.


Explains how this emergent hierarchy in HRM parallels the organization of the mouse cortex and supports the model's success on complex reasoning tasks.


Related Work


Discusses the related work in the fields of reasoning, algorithm learning, brain-inspired architectures, hierarchical memory, and linear attention.


Mentions notable models and techniques such as Neural Turing Machines, Differentiable Neural Computers, Universal Transformers, Spaun, the Tolman-Eichenbaum Machine, and linear attention variants.


Highlights how HRM builds upon and advances these prior works, offering improved data efficiency, model expressiveness, and biological plausibility.


Discussions


Discusses the Turing-completeness of HRM, highlighting its potential to simulate any Turing machine, overcoming the computational limitations of standard Transformers.


Mentions the limitations of reinforcement learning with chain-of-thought in comparison to HRM's gradient-based supervision and continuous state space.


Notes the relationship between HRM's recurrence and linear attention methods for language modeling, and how both offer potential efficiency improvements over standard Transformers.


Conclusion


Summarizes the key contributions of the paper, emphasizing HRM's ability to achieve significant computational depth with training stability and efficiency.


Concludes that HRM represents a promising alternative to CoT reasoning methods, moving towards a foundation for universal computation in AI.


},
	annote = {Methods \& Technical Approach:


HRM is composed of four modules: input network, low-level recurrent module, high-level recurrent module , and output network.


Dynamics unfold over N high-level cycles, each with T low-level timesteps.


Low-level state ​ converges toward an equilibrium conditioned​ during each cycle; high-level state updates once per cycle.


Gradient computation uses a local approximation scheme that requires only O(1) memory and avoids time unrolling.


Implemented efficiently in PyTorch with iterative local updates.


Relevance to UHRC Project:


Provides a unified computational model bridging high-level planning and low-level regulation—directly analogous to replacing multi-layer hierarchical control with a single end-to-end reasoning model.


The temporal separation of fast vs. slow modules mirrors the supervisory vs. local controller roles in control theory.


HRM’s efficient gradient approximation makes large-scale end-to-end control training feasible without BPTT’s memory bottlenecks.


Suggests a direct path for implementing your Unified Hierarchical Reasoning Controller (UHRC), where supervisory planning and actuation-level regulation emerge in one integrated architecture.


Strengths \& Limitations:


Strengths: biologically inspired design, efficient gradient computation, improved depth of reasoning, unification of timescales.


Limitations: not yet tested on physical control plants; focus primarily on reasoning and cognitive tasks; requires further validation in closed-loop control.


Possible Follow-ups for Your Project:


Adapt HRM’s dual-timescale dynamics (N high-level, T low-level) to control tasks with explicit separation of planning and regulation.


Use HRM’s memory-efficient gradient scheme to train controllers on long-horizon simulations without GPU bottlenecks.


Investigate “hierarchical convergence” as an alternative to layered PI/SMC architectures in nonlinear benchmark plants.


Evaluate stability and robustness properties of HRM when applied to closed-loop control (not yet explored in the original work).


},
	file = {Full Text PDF:C\:\\Users\\nunes\\Zotero\\storage\\PLMR8S8G\\Wang et al. - 2025 - Hierarchical Reasoning Model.pdf:application/pdf;Snapshot:C\:\\Users\\nunes\\Zotero\\storage\\BAIR9WFL\\2506.html:text/html},
}

@article{roth_human_2004,
	title = {Human in the {Loop} {Evaluation} of a {Mixed}-{Initiative} {System} for {Planning} and {Control} of {Multiple} {UAV} {Teams}},
